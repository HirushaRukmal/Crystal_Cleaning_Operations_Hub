# Set these in Render Environment settings; NEVER commit real secrets.
HOSTED_MODE=1
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require
SECRET_KEY=GENERATE_RANDOM_64_CHAR_VALUE
SETUP_TOKEN=GENERATE_ANOTHER_RANDOM_VALUE
BILLING_JOB_TOKEN=GENERATE_THIRD_RANDOM_VALUE
PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com
ENABLE_AUTOMATED_EMAIL=false
RESEND_API_KEY=
RESEND_FROM=
# Do not configure SMTP on Render Free: outbound SMTP ports are blocked.

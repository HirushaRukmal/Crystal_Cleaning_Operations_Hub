# Rename this file to .env to configure your business and deployment.
# Blank SECRET_KEY generates a persistent key in .local_secret on first launch.
DATABASE_URL=sqlite:///./crystal_cleaning.db
SECRET_KEY=
PUBLIC_BASE_URL=http://localhost:8000
COMPANY_NAME=Crystal Cleaning
COMPANY_ABN=
COMPANY_ADDRESS=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_BSB=
COMPANY_ACCOUNT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
ENABLE_AUTOMATED_EMAIL=false
